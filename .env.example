# Copy to .env locally. Never commit .env or share private keys.
# Indexer service
HOST=0.0.0.0
PORT=8787
CORS_ORIGIN=https://roastake-ex387b8yd-astrym.vercel.app,https://roastake-git-feat-degen-mode-easter-egg-astrym.vercel.app,https://roastake.vercel.app
# Cloud volume path (set to /data on Railway; leave unset locally to use the repository default)
# INDEXER_DATA_DIR=/data
# Optional server-side upstream key (server only; never set in Vite)
# FASTNEAR_API_KEY=

# Perps price keeper — NEAR Testnet signer
NEAR_OPERATOR_ACCOUNT_ID=roastake-dev-mta.testnet
NEAR_OPERATOR_PRIVATE_KEY=ed25519:REPLACE_WITH_LOCAL_TESTNET_PRIVATE_KEY
NEAR_TESTNET_RPC_URL=https://rpc.testnet.fastnear.com
PERPS_CONTRACT_ID=perps-v1.roastake-dev-mta.testnet

# Optional OutLayer Oracle Adapter requests — DISABLED by default.
# Uses a second Testnet signer so Oracle transactions cannot contend with Perps nonce updates.
ORACLE_ADAPTER_ENABLED=false
ORACLE_ADAPTER_CONTRACT_ID=roastake-oracle-v1.testnet
ORACLE_ADAPTER_MARKET=GESHA-DEMO/USD
# Create/fund this separate Testnet account and authorize it on the Oracle Adapter before enabling.
# Store the actual private key only in the hosting provider's encrypted secrets.
ORACLE_OPERATOR_ACCOUNT_ID=
ORACLE_OPERATOR_PRIVATE_KEY=
# 0.01 NEAR (10 milliNEAR) in yoctoNEAR; set only after reviewing the Testnet execution budget.
ORACLE_ADAPTER_DEPOSIT_YOCTO=10000000000000000000000
